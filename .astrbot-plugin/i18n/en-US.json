{
  "metadata": {
    "display_name": "Understand Anything",
    "short_desc": "Turn projects, documents, and knowledge bases into interactive knowledge graphs in AstrBot.",
    "desc": "Full AstrBot host adapter plugin for Understand Anything."
  },
  "config": {
    "provider_id": {
      "description": "AstrBot chat provider ID",
      "hint": "Leave empty to use the current session provider."
    },
    "cleanup_github_cache_after_analysis": {
      "description": "Clean GitHub clone cache after analysis",
      "hint": "When enabled, only the cloned source cache is removed after a GitHub analysis job. Graph artifacts are kept in plugin data."
    },
    "max_concurrent_jobs": {
      "description": "Maximum concurrent analysis jobs",
      "hint": "Large analyses can consume model tokens and CPU. Keep this low unless the host has enough resources."
    },
    "max_parallel_file_agents": {
      "description": "Maximum parallel file-analyzer SubAgents per analysis job",
      "hint": "Controls batch-level SubAgent concurrency inside one /understand job."
    },
    "max_parallel_article_agents": {
      "description": "Maximum parallel article-analyzer SubAgents per knowledge job",
      "hint": "Controls batch-level SubAgent concurrency inside one /understand-knowledge job."
    },
    "subagent_provider_id": {
      "description": "AstrBot chat provider ID for Understand Anything SubAgents",
      "hint": "Leave empty to reuse provider_id, then the current session provider."
    },
    "auto_build": {
      "description": "Automatically repair missing bundled runtime dependencies",
      "hint": "When enabled, the first use can run pnpm install/build inside the plugin's understand-anything directory if dependencies or dist files are missing."
    },
    "auto_update_poll_interval": {
      "description": "Auto-update polling interval in seconds",
      "hint": "0 disables background polling. Use chat commands for explicit updates."
    },
    "default_write_mode": {
      "description": "Default graph output mode",
      "hint": "Understand Anything writes graph files into the target project.",
      "labels": [
        "Project .understand-anything"
      ]
    }
  },
