{
  "metadata": {
    "display_name": "Understand Anything",
    "short_desc": "将项目、文档和知识库转换为 AstrBot 中的交互式知识图谱。",
    "desc": "为 AstrBot 提供完整 Understand Anything 宿主适配能力。"
  },
  "config": {
    "provider_id": {
      "description": "AstrBot 聊天 Provider ID",
      "hint": "留空则使用当前会话 Provider。"
    },
    "cleanup_github_cache_after_analysis": {
      "description": "分析后清理 GitHub clone 缓存",
      "hint": "启用后，GitHub 分析任务结束只删除克隆的源码缓存，图谱产物会保留在插件数据目录。"
    },
    "github_command_timeout_seconds": {
      "description": "GitHub 源码命令超时（秒）",
      "hint": "限制 GitHub 源码准备阶段每个 git ls-remote、clone、fetch 和 checkout 命令的耗时。仅在仓库很大或网络很慢时调高。"
    },
    "max_concurrent_jobs": {
      "description": "最大并发分析任务数",
      "hint": "大型分析会消耗模型 token 和 CPU。除非主机资源充足，否则建议保持较低数值。"
    },
    "max_parallel_file_agents": {
      "description": "每个分析任务的最大并行 file-analyzer SubAgent 数",
      "hint": "控制单个 /understand job 内部的批次级 SubAgent 并发。"
    },
    "max_parallel_article_agents": {
      "description": "每个知识分析任务的最大并行 article-analyzer SubAgent 数",
      "hint": "控制单个 /understand-knowledge job 内部的批次级 SubAgent 并发。"
    },
    "subagent_provider_id": {
      "description": "Understand Anything SubAgents 使用的 AstrBot 聊天 Provider ID",
      "hint": "留空则复用 provider_id，再退回当前会话 Provider。"
    },
    "output_locale": {
      "description": "Understand Anything 生成内容的输出语言",
      "hint": "自动模式优先跟随 WebUI/API 语言，其次跟随聊天消息语言，最后回退到简体中文。",
      "labels": [
        "跟随 WebUI / 聊天语言",
        "简体中文",
        "英文",
        "俄文"
      ]
    },
    "auto_build": {
      "description": "自动修复缺失的内置运行依赖",
      "hint": "启用后，首次使用可在插件 understand-anything 目录内运行 pnpm install/build，修复缺失的依赖或 dist 文件。"
    },
    "auto_update_poll_interval": {
      "description": "自动更新轮询间隔（秒）",
      "hint": "0 表示禁用后台轮询。需要更新时可使用聊天命令手动触发。"
    },
    "default_write_mode": {
      "description": "默认图谱输出模式",
      "hint": "Understand Anything 会将图谱文件写入目标项目。",
      "labels": [
        "项目 .understand-anything"
      ]
    }
  },
